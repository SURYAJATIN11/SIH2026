{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd southern-railway-block-planner-frontend && npm install && npm run build",
  "outputDirectory": "southern-railway-block-planner-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sih2026-hrnz.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://sih2026-hrnz.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
